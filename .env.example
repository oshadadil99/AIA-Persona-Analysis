# Copy to .env.local and fill in real values there. Never commit .env.local.
# Nothing below is wired up yet — these are the vars the build order in
# PROJECT_GUIDE.md Section 7 will need, in roughly the order they're needed.

# --- Supabase (step 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pinecone (step 3) ---
PINECONE_API_KEY=
PINECONE_INDEX=
# Serverless index spec. Region choice affects latency to Vertex AI us-central1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Must match EMBEDDING_OUTPUT_DIMENSIONALITY below — Pinecone index dimension
# is fixed at creation and cannot be changed without recreating the index.
PINECONE_DIMENSION=768

# --- Inngest (step 5) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Vertex AI / Gemini (step 6) ---
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Full contents of the service account JSON, as a single-line string.
# Set this in the Vercel dashboard for deploys. For local dev, paste it into
# .env.local yourself — do not save the .json key file inside this repo.
GCP_SERVICE_ACCOUNT_JSON=

# --- Vertex AI embeddings (step 3, feeds the Pinecone index above) ---
# Same GCP auth as above (GCP_PROJECT_ID + GCP_SERVICE_ACCOUNT_JSON), different model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 supports configurable output dimensionality (768/1536/3072).
# 768 keeps Pinecone storage/cost down; must equal PINECONE_DIMENSION above.
EMBEDDING_OUTPUT_DIMENSIONALITY=768
